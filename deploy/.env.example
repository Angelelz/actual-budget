# ============================================================
# Copy this file to .env on the server and fill in real values.
# .env is gitignored. Do NOT commit it.
# ============================================================

# ---- Authentik image tag ----
# Pin a specific release in production. Check:
#   https://github.com/goauthentik/authentik/releases
AUTHENTIK_TAG=2026.2.0

# ---- Postgres (used by Authentik only) ----
PG_USER=authentik
PG_DB=authentik
# Generate with: openssl rand -base64 36
PG_PASS=REPLACE_ME_postgres_password

# ---- Authentik ----
# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=REPLACE_ME_authentik_secret_key

# ---- Actual sync-server OpenID wiring ----
# These are filled in AFTER you create the OIDC "Application" in
# Authentik's admin UI. See deploy workflow below.

# Public HTTPS URL where Actual is reachable (the cloudflared hostname).
# Used for OIDC redirect URIs — must match what Authentik has registered.
ACTUAL_OPENID_SERVER_HOSTNAME=https://actual.example.com

# Authentik's OIDC discovery document.
# Pattern: https://<authentik-host>/application/o/<app-slug>/.well-known/openid-configuration
ACTUAL_OPENID_DISCOVERY_URL=https://auth.example.com/application/o/actual/.well-known/openid-configuration

# From the Authentik OAuth2 provider you create for Actual.
ACTUAL_OPENID_CLIENT_ID=REPLACE_ME_client_id
ACTUAL_OPENID_CLIENT_SECRET=REPLACE_ME_client_secret

# cloudflared terminates TLS and forwards to localhost. Trust it.
# 127.0.0.1/32 is enough since both containers share the host network stack
# via the published 127.0.0.1 port bindings.
ACTUAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128
